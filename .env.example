# ============================================================
# wasteNews Docker 环境变量模板
# 复制为 .env 并修改
# ============================================================

# --- MySQL 配置 ---
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=news_app

# --- 新闻拉取配置 ---
NEWS_FETCH_INTERVAL=30
NEWS_TOTAL_COUNT=300

# --- 前端源码目录 ---
# 选项1: 复制前端到 ./frontend/ (推荐)
#   cp -r /mnt/e/BaiduNetdiskDownload/项目物料/03-前端项目代码/xwzx-news ./frontend
# 选项2: 直接指定路径
#   FRONTEND_PATH=/mnt/e/BaiduNetdiskDownload/项目物料/03-前端项目代码/xwzx-news
FRONTEND_PATH=./frontend
